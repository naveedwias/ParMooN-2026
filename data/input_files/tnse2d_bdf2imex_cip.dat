[ BDF2-IMEX with CIP, Scott-Vogelius, smooth example ]
outfile: tnse2d_bdf2imex.out
boundary_file: Default_UnitSquare
geo_file: TwoTriangles
refinement_n_initial_steps: 3
refinement_final_step_barycentric: true
problem_type: 3
example: 25
verbosity: 1
output_write_vtk: false
output_compute_errors: true
output_basename: tnse2d_bdf2imex
space_discretization_type: galerkin
graddiv_stab: 0.0
solver_type: direct
direct_solver_type: umfpack
VELOCITY_SPACE: 12
PRESSURE_SPACE: -4711
reynolds_number: 1.0e6
NSTYPE: 4
LAPLACETYPE: 0
NSE_NONLINEAR_FORM: 0
time_start: 0.0
time_end: 1.0
time_step_length: 0.125
cip_delta1: 1.0e-2
cip_delta2: 1.0e-4
cip_delta3: 1.0e-6
cip_u_min: 0.25
pressure_amplitude: 1.0
bdf2_start: stokes_projection
bdf2_write_table: tnse2d_bdf2imex_table.txt
