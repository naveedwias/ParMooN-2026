[ BDF2-IMEX with CIP, Scott-Vogelius: periodic Taylor-Green vortex (example 35) on (0, 2 pi)^2, exact solution; nu = 1e-6; variants: see scripts/run_tgv_bdf2_studies.sh ]
outfile: tnse2d_bdf2imex_tgv.out
boundary_file: ../ParMooN-2026/data/mesh/SquareTwoPi.PRM
geo_file: ../ParMooN-2026/data/mesh/SquareTwoPi4x4_tria.GEO
refinement_n_initial_steps: 3
refinement_final_step_barycentric: true
problem_type: 3
example: 35
verbosity: 1
output_write_vtk: false
output_compute_errors: true
output_basename: tnse2d_bdf2imex_tgv
space_discretization_type: galerkin
graddiv_stab: 0.0
solver_type: direct
direct_solver_type: umfpack
VELOCITY_SPACE: 12
PRESSURE_SPACE: -4711
reynolds_number: 1.0e6
NSTYPE: 4
LAPLACETYPE: 0
NSE_NONLINEAR_FORM: 0
time_start: 0.0
time_end: 5.0
time_step_length: 0.025
cip_delta1: 1.0e-2
cip_delta2: 1.0e-4
cip_delta3: 1.0e-6
cip_u_min: 0.25
pressure_amplitude: 1.0
bdf2_start: euler
bdf2_write_table: tnse2d_bdf2imex_tgv_table.txt
# periodic boundaries (the Stokes projection start is not defined for them)
bdf2_periodic: true
periodic_translations: (6.283185307179586,0.,0.,6.283185307179586)
tgv_periodic: true
tgv_length: 6.283185307179586
tgv_wavenumber: 1.0
tgv_amplitude: 1.0
