[ ParMooN database: adaptive SUPG for evolutionary CD (de Frutos, Garcia-Archilla, John, Novo 2014) ]
outfile: ex4new.out
boundary_file: Default_UnitSquare
geo_file: ../ParMooN-2026/data/mesh/UnitSquare25x25_tria.GEO
refinement_n_initial_steps: 0
conforming_closure: true
problem_type: 2
example: 15
verbosity: 1
output_write_vtk: false
output_compute_errors: true
output_basename: ex2
space_discretization_type: supg
diffusion_coefficient: 1.0e-6
ANSATZ_ORDER: 1
SDFEM_TYPE: 0
DELTA0: 0.5
DELTA1: 0.0
time_discretization: crank_nicolson
time_start: 0.0
time_end: 6.2831853072
time_step_length: 1.0e-3
solver_type: direct
direct_solver_type: umfpack
adaptive_mesh: true
adaptive_tol1: 3.0e-3
adaptive_tol2: 1.5e-4
adaptive_max_cell_level: 14
trab2_adaptive: true
trab2_tolt: 1.0e-5
trab2_dt0: 1.0e-10
trab2_dt_max: 0.05
adaptive_output_time: 0.5
tcd_estimator_mu0: 0.0
tcd_write_table: ex4new_table.txt
