[ ParMooN database: adaptive SUPG (FGJN14), Example 5 ]
outfile: tcd2d_adaptive_tr_ex5.out
boundary_file: Default_UnitSquare
geo_file: ../ParMooN-2026/data/mesh/UnitSquare25x25_tria.GEO
refinement_n_initial_steps: 0
conforming_closure: true
problem_type: 2
example: 16
verbosity: 1
output_write_vtk: true
output_directory: vtk
steps_per_output: 40
output_write_ps: true
output_compute_errors: false
output_basename: fgjn_ex5
space_discretization_type: supg
diffusion_coefficient: 1.0e-5
ANSATZ_ORDER: 1
SDFEM_TYPE: 0
DELTA0: 0.5
DELTA1: 0.0
time_start: 0.0
time_end: 1.8
time_step_length: 1.0e-2
solver_type: direct
direct_solver_type: umfpack
adaptive_mesh: true
trab2_adaptive: true
trab2_tolt: 1.0e-5
trab2_dt0: 1.0e-10
trab2_dt_max: 0.1
adaptive_output_time: 0.2
adaptive_coarsening: true
adaptive_tol1: 1.0e-3
adaptive_tol2: 5.0e-5
tcd_estimator_mu0: 0.0
adaptive_max_cell_level: 14
tcd_write_table: tcd2d_adaptive_tr_ex5_table.txt
# averaging of the TR-AB2 integrator as in de Frutos et al. (2014)
trab2_averaging: periodic
