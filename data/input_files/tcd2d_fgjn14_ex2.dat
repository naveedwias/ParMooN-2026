[ ParMooN database: adaptive SUPG for evolutionary CD (de Frutos, Garcia-Archilla, John, Novo 2014) ]
outfile: ex2tr.out
boundary_file: Default_UnitSquare
geo_file: TwoTriangles
refinement_n_initial_steps: 5
conforming_closure: true
problem_type: 2
example: 11
verbosity: 1
output_write_vtk: false
output_compute_errors: true
output_basename: ex2
space_discretization_type: supg
diffusion_coefficient: 1.0e-3
ANSATZ_ORDER: 1
SDFEM_TYPE: 0
DELTA0: 0.5
DELTA1: 0.0
time_discretization: crank_nicolson
time_start: 0.0
time_end: 2.0
time_step_length: 1.0e-3
solver_type: direct
direct_solver_type: umfpack
tcd_adaptive: false
tcd_time_adaptive: true
tcd_tolt: 1.0e-5
tcd_dt0: 1.0e-10
tcd_dt_max: 0.05
tcd_output_time: 0.5
tcd_estimator_mu0: 1.0
tcd_refine_every: 50
tcd_write_table: ex2tr_table.txt
