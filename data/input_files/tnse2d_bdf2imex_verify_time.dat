[ BDF2-IMEX, CIP, Scott-Vogelius: temporal verification with example 28 (u in P2, p in P1, time-dependent Dirichlet data) ]
outfile: tnse2d_bdf2imex_verify_time.out
boundary_file: Default_UnitSquare
geo_file: TwoTriangles
refinement_n_initial_steps: 3
refinement_final_step_barycentric: true
problem_type: 3
example: 28
verbosity: 1
output_write_vtk: false
output_compute_errors: true
output_basename: tnse2d_bdf2imex_verify_time
space_discretization_type: galerkin
graddiv_stab: 0.0
solver_type: direct
direct_solver_type: umfpack
VELOCITY_SPACE: 12
PRESSURE_SPACE: -4711
reynolds_number: 100.0
NSTYPE: 4
LAPLACETYPE: 0
NSE_NONLINEAR_FORM: 0
time_start: 0.0
time_end: 1.0
time_step_length: 0.05
cip_delta1: 1.0e-2
cip_delta2: 1.0e-4
cip_delta3: 1.0e-6
cip_u_min: 0.25
pressure_amplitude: 1.0
bdf2_start: stokes_projection
bdf2_write_table: tnse2d_bdf2imex_verify_time_table.txt
